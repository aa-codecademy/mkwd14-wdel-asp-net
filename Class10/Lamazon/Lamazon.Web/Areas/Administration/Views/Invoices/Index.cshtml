@model InvoiceViewModel

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-end">
            <div class="form-inline">
                <input id="inputSearch" type="search" class="form-control txt-search" placeholder="Invoice number or customer" />
                <button id="btnSearch" class="btn btn-search btn-info" type="button"><i class="material-icons">search</i></button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table id="invoicesTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.InvoiceNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.User)</th>
                    <th>@Html.DisplayNameFor(model => model.TotalAmount)</th>
                    <th class="text-center">@Html.DisplayNameFor(model => model.InvoiceStatus)</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const invoicesTable = new DataTable('#invoicesTable', {
            order: [[0, 'desc']],
            ajax: {
                url: '@Url.Action("GetInvoices")',
                type: 'POST',
                data: function (data) {
                    data.search.value = $('#inputSearch').val();
                }
            },
            columns: [
                { data: 'invoiceNumber', name: 'InvoiceNumber' },
                { data: 'user.fullName', name: 'User.FullName', render: DataTable.render.text() },
                { data: 'totalAmount', name: 'TotalAmount', render: DataTable.render.number(',', '.', 2, '$') },
                { data: 'invoiceStatusName', name: 'InvoiceStatus', className: 'text-center' },
                {
                    data: 'id',
                    className: 'column-actions',
                    orderable: false,
                    render: function (id) {
                        return actionLink('@Url.Action("Details")/' + id, 'visibility', 'text-info');
                    }
                }
            ]
        });

        bindTableSearch(invoicesTable);
    </script>
}
