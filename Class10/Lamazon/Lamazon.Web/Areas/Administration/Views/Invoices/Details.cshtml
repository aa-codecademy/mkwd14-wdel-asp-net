@model InvoiceViewModel

<div class="card">
    <div class="card-header">
        <h4 class="card-title">Invoice @Model.InvoiceNumber</h4>
        <p class="card-category">@Model.InvoiceStatusName</p>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group bmd-form-group is-filled">
                    <label asp-for="InvoiceNumber" class="bmd-label-floating"></label>
                    <input asp-for="InvoiceNumber" class="form-control" readonly />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group bmd-form-group is-filled">
                    <label asp-for="InvoiceDate" class="bmd-label-floating"></label>
                    <input value="@Model.InvoiceDate.ToString("dd.MM.yyyy HH:mm")" class="form-control" readonly />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group bmd-form-group is-filled">
                    <label class="bmd-label-floating">Customer</label>
                    <input value="@Model.User?.FullName" class="form-control" readonly />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group bmd-form-group is-filled">
                    <label class="bmd-label-floating">Email</label>
                    <input value="@Model.User?.Email" class="form-control" readonly />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group bmd-form-group is-filled">
                    <label asp-for="TotalAmount" class="bmd-label-floating"></label>
                    <input value="$@Model.TotalAmount.ToString("N2")" class="form-control" readonly />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group bmd-form-group is-filled">
                    <label asp-for="InvoiceStatus" class="bmd-label-floating"></label>
                    <input value="@Model.InvoiceStatusName" class="form-control" readonly />
                </div>
            </div>
        </div>

        <table class="table table-striped table-hover preview-table mt-5">
            <thead>
                <tr>
                    <th>No</th>
                    <th>Product name</th>
                    <th class="text-right">Product price</th>
                    <th class="text-center">Qty</th>
                    <th class="text-right">Total price</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.InvoiceLineItems.Count; i++)
                {
                    var lineItem = Model.InvoiceLineItems[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@lineItem.ProductName</td>
                        <td class="text-right">$@lineItem.ProductPrice.ToString("N2")</td>
                        <td class="text-center">@lineItem.Quantity</td>
                        <td class="text-right">$@lineItem.TotalPrice.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer justify-content-end">
        <a class="btn btn-default" asp-action="Index">Back</a>
        @* Only an unpaid invoice can change (the service checks it too) *@
        @if (Model.InvoiceStatus == InvoiceStatusEnum.PendingPayment)
        {
            <button class="btn btn-danger" type="button" data-toggle="modal" data-target="#cancelModal">Cancel invoice</button>
            <button class="btn btn-success" type="button" data-toggle="modal" data-target="#paidModal">Set as paid</button>
        }
    </div>
</div>

@if (Model.InvoiceStatus == InvoiceStatusEnum.PendingPayment)
{
    <partial name="_ConfirmModal" model="@(new ConfirmModalViewModel
             {
                 ModalId = "cancelModal",
                 Title = "Cancel invoice",
                 Message = $"Are you sure you want to cancel invoice {Model.InvoiceNumber}?",
                 Action = "Cancel",
                 EntityId = Model.Id,
                 ConfirmText = "Cancel invoice",
                 ConfirmCssClass = "btn-danger",
             })" />

    <partial name="_ConfirmModal" model="@(new ConfirmModalViewModel
             {
                 ModalId = "paidModal",
                 Title = "Set invoice as paid",
                 Message = $"Mark invoice {Model.InvoiceNumber} as paid?",
                 Action = "SetAsPaid",
                 EntityId = Model.Id,
                 ConfirmText = "Set as paid",
                 ConfirmCssClass = "btn-success",
             })" />
}
