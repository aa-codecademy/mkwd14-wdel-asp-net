@model ProductViewModel

@* This page IS the "are you sure?" step: the form posts to Delete (DeleteConfirmed in the controller) *@
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Delete product</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" />
                </div>
                <div class="col-md-9">
                    <h4>@Model.Name</h4>
                    <p>@Model.ProductCategoryName &middot; $@Model.Price.ToString("N2")</p>
                    <p>Are you sure you want to delete this product?</p>
                    <p class="text-muted">It disappears from the shop. Existing orders and invoices keep it.</p>
                </div>
            </div>
        </div>
        <div class="card-footer justify-content-end">
            <a class="btn btn-default" asp-action="Index">Cancel</a>
            <button class="btn btn-danger" type="submit">Delete</button>
        </div>
    </div>
</form>
