@model ProductViewModel

<button type="button" class="btn btn-remove-from-cart btn-danger @(Model.IsAddedToCart ? "" : "hidden")" data-url="@Url.Action("RemoveFromCart", "Products")" data-product-id="@Model.Id">
    Remove from cart
</button>
<button type="button" class="btn btn-add-to-cart btn-success @(Model.IsAddedToCart ? "hidden" : "")" data-url="@Url.Action("AddToCart", "Products")" data-product-id="@Model.Id">
    Add to cart
</button>
