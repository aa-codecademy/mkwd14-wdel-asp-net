@model ProductCategoryViewModel


<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <a class="btn btn-success btn-add-new" asp-action="Create" title="New category"><i class="material-icons">add</i></a>

            <div class="form-inline">
                <input id="inputSearch" type="search" class="form-control txt-search" placeholder="Search product categories" />
                <button id="btnSearch" class="btn btn-info btn-search" type="button"><i class="material-icons">search</i></button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table id="productCategoriesTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var productCategoriesTable = new DataTable('#productCategoriesTable', {
            ajax: {
                url: '@Url.Action("GetProductCategories")',
                type: 'POST',
                data: function (data) {
                    data.search.value = $("#inputSearch").val();
                }
            },
            columns: [
                {
                    data: 'name',
                    name: 'Name',
                    render: DataTable.render.text()
                },
                {
                    data: 'id',
                    className: 'column-actions',
                    orderable: false,
                    render: function (id) {
                        return actionLink('@Url.Action("Edit")/' + id, 'edit', 'text-warning') +
                            actionLink('@Url.Action("Delete")/' + id, 'delete', 'text-danger')
                    }
                },
            ]
        })

        bindTableSearch(productCategoriesTable);
    </script>
}
